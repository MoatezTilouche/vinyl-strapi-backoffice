    "sellableUnits": { "type": "relation", "relation": "oneToMany", "target": "api::sellable-unit.sellable-unit", "mappedBy": "tenant" },
    "channelListings": { "type": "relation", "relation": "oneToMany", "target": "api::channel-listing.channel-listing", "mappedBy": "tenant" },
    "syncEvents": { "type": "relation", "relation": "oneToMany", "target": "api::marketplace-sync-event.marketplace-sync-event", "mappedBy": "tenant" }
  }
