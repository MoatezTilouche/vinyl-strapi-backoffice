{
  "kind": "collectionType",
  "collectionName": "sellable_units",
  "info": { "singularName": "sellable-unit", "pluralName": "sellable-units", "displayName": "Sellable Unit" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "tenant": { "type": "relation", "relation": "manyToOne", "target": "api::tenant.tenant", "inversedBy": "sellableUnits", "required": true },
    "product": { "type": "relation", "relation": "manyToOne", "target": "api::product.product", "inversedBy": "sellableUnits", "required": true },
    "sku": { "type": "string", "required": true, "unique": true },
    "price": { "type": "decimal", "required": true, "min": 0 },
    "currency": { "type": "enumeration", "enum": ["EUR", "USD", "GBP"], "default": "EUR", "required": true },
    "mediaCondition": { "type": "string", "required": true },
    "sleeveCondition": { "type": "string", "required": true },
    "sellerComment": { "type": "text" },
    "saleStatus": { "type": "enumeration", "enum": ["available", "reserved", "sold", "out_of_stock", "archived"], "default": "available", "required": true },
    "quantityAvailable": { "type": "integer", "default": 1, "min": 0, "required": true },
    "internalLocation": { "type": "string" },
    "channelListings": { "type": "relation", "relation": "oneToMany", "target": "api::channel-listing.channel-listing", "mappedBy": "sellableUnit" },
    "syncEvents": { "type": "relation", "relation": "oneToMany", "target": "api::marketplace-sync-event.marketplace-sync-event", "mappedBy": "sellableUnit" }
  }
}
