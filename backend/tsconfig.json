{
  "extends": "@strapi/typescript-utils/tsconfigs/server",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "Node16",
    "moduleResolution": "Node16"
  },
  "include": ["./", "./**/*.ts", "./**/*.tsx", "./**/*.js", "./**/*.json"],
  "exclude": ["node_modules/", "build/", "dist/", ".cache/", ".tmp/", "src/admin/", "**/*.test.ts", "tests/"]
}
